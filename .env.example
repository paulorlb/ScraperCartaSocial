# Copy to .env at the repository root. Notebooks load this file when needed.
# Never commit credentials. Existing shell variables take precedence.
GOOGLE_MAPS_API_KEY=
HTTP_USER_AGENT=CartaSocialPipeline/1.0
NOMINATIM_URL=http://localhost:8080
# Optional HTTP Basic authentication for a private Nominatim instance.
NOMINATIM_USERNAME=
NOMINATIM_PASSWORD=
